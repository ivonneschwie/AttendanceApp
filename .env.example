APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Logging
LOG_CHANNEL=stack
LOG_LEVEL=debug

# Database (Only used as framework default; app runs entirely on Firebase)
DB_CONNECTION=sqlite

# Session, Cache, Filesystem & Queue (Using file/sync drivers to bypass local DB)
SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

# Email & Broadcasting (Routed to logs for local development)
MAIL_MAILER=log
BROADCAST_CONNECTION=log

# Firebase Configuration
FIREBASE_CREDENTIALS=storage/app/firebase/firebase-credentials.json
FIREBASE_PROJECT_ID=

# Frontend Config
VITE_APP_NAME="${APP_NAME}"
